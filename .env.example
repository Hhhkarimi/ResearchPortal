NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_DATA_MODE=production

# Server-only PostgreSQL settings. Never expose DATABASE_URL with NEXT_PUBLIC_.
DATA_BACKEND=json
DATABASE_URL=postgresql://research_portal:change-me@localhost:5432/research_portal
DATABASE_SSL=false
DATABASE_MAX_CONNECTIONS=5
DATABASE_IDLE_TIMEOUT_SECONDS=20
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_MS=3000

# Required by `npm run db:import`.
SNAPSHOT_RELEASE_KEY=research-portal-2026-08-12
SNAPSHOT_AS_OF_DATE=2026-08-12

# Reproducible Python data pipeline. Put artifact/work roots on durable local
# storage or an attached volume in production runners.
PIPELINE_SNAPSHOT_DATE=2026-08-12
PIPELINE_SCHEMA_VERSION=11.0.0
PIPELINE_METHODOLOGY_VERSION=RTPMI-4.2-ISC
PIPELINE_ARTIFACT_ROOT=.pipeline/artifacts
PIPELINE_WORK_ROOT=.pipeline/work
