{
  "name": "iran-research-portal-observatory",
  "version": "11.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate:data": "node scripts/validate-data.mjs && node scripts/validate-research-document-scope.mjs",
    "normalize:public": "node scripts/normalize-public-data.mjs",
    "filter:research-documents": "node scripts/filter-research-documents.mjs",
    "prepare:data": "node scripts/run-pipeline.mjs run --publish",
    "prepare:data:legacy": "node scripts/import-research-audit.mjs && node scripts/import-portal-document-reaudit.mjs && node scripts/promote-discovery.mjs && node scripts/normalize-public-data.mjs && node scripts/filter-research-documents.mjs && node scripts/build-deep-audit.mjs && node scripts/finalize-rtpmi.mjs && node scripts/build-provenance.mjs && node scripts/build-dimension-evidence.mjs && node scripts/recompute-summary.mjs && node scripts/build-public-data.mjs && node scripts/build-audit-packets.mjs && node scripts/export-csv.mjs",
    "pipeline:plan": "node scripts/run-pipeline.mjs plan",
    "pipeline:validate": "node scripts/run-pipeline.mjs validate",
    "pipeline:test": "node scripts/run-pipeline.mjs --test",
    "discover:research": "node scripts/deep-crawl-research.mjs",
    "promote:discovery": "node scripts/promote-discovery.mjs && node scripts/filter-research-documents.mjs",
    "crawl:research": "npm run discover:research && npm run promote:discovery",
    "audit:all": "node scripts/audit-all-isc.mjs",
    "monitor:links": "node scripts/audit-all-isc.mjs",
    "release:check": "npm run prepare:data && npm run validate:data && npm run validate:no-social",
    "validate:no-social": "node scripts/check-no-social-evidence.mjs",
    "validate:v11": "node scripts/validate-v11-observatory.mjs && node scripts/validate-interface-contracts.mjs",
    "validate:interface": "node scripts/validate-interface-contracts.mjs",
    "update:international-rankings": "node scripts/update-international-rankings.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:import": "node scripts/db-import-snapshot.mjs",
    "db:validate": "node scripts/db-validate.mjs",
    "db:publish": "node scripts/db-publish-snapshot.mjs"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "next": "16.3.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.0",
    "typescript": "5.9.3"
  }
}
